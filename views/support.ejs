<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ingredient Checker - Support</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <%- include("./partials/head") %>

      <style>
        body {
          font-family: "Georgia", serif;
        }

        /* Main container */
        .support-wrapper {
          max-width: 1100px;
          margin: 0 auto;
          padding: 0 20px;
        }

        /* FAQ + Image layout */
        .faq-box {
          display: flex;
          align-items: center;
          gap: 0;
          margin-top: 40px;
        }

        .faq-text {
          flex: 1;
        }

        .faq-text p {
          margin-bottom: 8px;
        }

        .faq-image {
          flex: 1;
          text-align: center;
          margin-left: -40px;
          /*closes visual gap */
        }

        .faq-image img {
          max-width: 80%;
          height: auto;
          border-radius: 6px;
        }

        /* Contact section */
        .contact-box {
          max-width: 600px;
          margin: 60px auto 0;
        }

        .contact-box h4 {
          text-align: center;
          margin-bottom: 20px;
        }

        .contact-box p {
          display: flex;
          align-items: center;
          gap: 10px;
          margin-bottom: 12px;
          font-size: 16px;
        }

        /* Responsive */
        @media (max-width: 768px) {
          .faq-box {
            flex-direction: column;
            /* stack vertically */
            align-items: flex-start;
          }

          .faq-text {
            order: 1;
            width: 100%;
          }

          .faq-image {
            order: 2;
            /* image goes DOWN */
            margin-left: 0;
            /*remove negative margin */
            margin-top: 30px;
            width: 100%;
            text-align: center;
          }

          .faq-image img {
            max-width: 70%;
          }
        }

        .accordion-button {
          font-family: "Georgia", serif;
          font-weight: 600;
        }

        .accordion-button:not(.collapsed) {
          background-color: #e1f2eb;
          color: #000;
        }
      </style>
  </head>

  <body>

    <%- include("./partials/nav") %>

      <div class="container py-5 support-wrapper">

        <!-- Page Heading -->
        <div class="text-center mb-5">
          <h1 class="fw-bold">Support</h1>
          <p class="text-muted mt-2">
            We’re here to help you get the most out of IngrediSafe.
          </p>
        </div>

        <!-- FAQ Section -->
        <div class="faq-box">

          <!-- FAQ TEXT -->
          <div class="faq-text">
            <h4 class="mb-4">Frequently Asked Questions</h4>

            <div class="accordion" id="faqAccordion">

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq1">
                    How does the ingredient checker work?
                  </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                  <div class="accordion-body">
                    Our ingredient checker analyzes product ingredients and compares them
                    with your health preferences.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq2">
                    Is the ingredient analysis medically accurate?
                  </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                  <div class="accordion-body">
                    It is based on trusted nutritional databases and does not replace medical advice.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq3">
                    Can I save my health preferences?
                  </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                  <div class="accordion-body">
                    Yes, you can manage them anytime from your Health Profile.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq4">
                    Is my data safe and private?
                  </button>
                </h2>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                  <div class="accordion-body">
                    Yes. Your data is securely stored using industry standards.
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- FAQ IMAGE -->
          <div class="faq-image">
            <img src="/image/waffle.png" alt="Waffle">
          </div>

        </div>

        <!-- CONTACT SUPPORT -->
        <div class="contact-box">
          <h4>Contact Support</h4>

          <p>
            <i class="fa-solid fa-envelope"></i>
            <span>hitee0025@gmail.com</span>
          </p>

          <p>
            <i class="fa-solid fa-phone"></i>
            <span>+91 82380 75776</span>
          </p>

          <p>
            <i class="fa-solid fa-clock"></i>
            <span>Mon – Fri, 9:00 AM – 6:00 PM</span>
          </p>
        </div>

      </div>


      <%- include("./partials/footer") %>
      <%- include("./partials/script") %>

  </body>

</html>