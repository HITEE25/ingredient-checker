<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <%- include("./partials/head") %>
  <style>
    body {
      background-color: #fff;
      font-family: "Georgia", serif;
    }

    .login-box {
      max-width: 420px;
      margin: 80px auto;
      background: #fff;
      padding: 30px;
      border-radius: 6px;
    }

    .login-box h2 {
      text-align: center;
      margin-bottom: 25px;
      font-weight: 600;
    }

    .form-control {
      height: 45px;
      border-radius: 4px;
    }

    .login-btn {
      background: #a287b4;
      border: none;
      height: 45px;
      font-weight: 600;
    }

    .login-btn:hover {
      background: #8f6aa6;
    }

    .form-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
    }

    .form-footer a {
      color: #6fb28f;
      text-decoration: none;
      font-weight: 500;
    }

    .signup-text {
      text-align: center;
      margin-top: 20px;
      font-size: 15px;
    }

    .signup-text a {
      color: #6fb28f;
      font-weight: 600;
      text-decoration: none;
    }

    .error-text {
      color: red;
      font-size: 14px;
      margin-bottom: 10px;
      text-align: center;
    }
  </style>
</head>

<body>
  <%- include("./partials/nav") %>
    <div class="login-box">
    <h2>Log In</h2>

    <% if (typeof err !== "undefined") { %>
      <div class="error-text"><%= err %></div>
    <% } %>

    <form method="POST" action="/user/signin">
      <div class="mb-3">
        <label class="form-label">Email *</label>
        <input
          type="email"
          class="form-control"
          name="email"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Password *</label>
        <input
          type="password"
          class="form-control"
          name="password"
          required
        >
      </div>

      <div class="form-footer mb-3">
        <div>
          <input type="checkbox" id="remember">
          <label for="remember"> Remember me</label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100 login-btn">
        Log In
      </button>
    </form>

    <div class="signup-text">
      Don’t have an account?
      <a href="/user/signup">Sign up!</a>
    </div>
  </div>

    <%- include("./partials/footer") %>
    <%- include("./partials/script") %>
</body>

</html>